# WebGate RDP - Server Configuration
# Copy to .env and adjust values

# Server
HOST=0.0.0.0
PORT=8443
TLS_CERT=./certs/server.crt
TLS_KEY=./certs/server.key

# RDP Target
RDP_HOST=127.0.0.1
RDP_PORT=3389

# Session
SESSION_SECRET=change-this-to-a-random-secret
SESSION_TIMEOUT=3600000

# Limits
MAX_SESSIONS=50

# Paths
GHOSTSCRIPT_PATH=gswin64c
PRINT_SPOOL_DIR=./print-spool
FILE_TRANSFER_DIR=./file-transfer
DATA_DIR=./data

# Logging
LOG_LEVEL=info
